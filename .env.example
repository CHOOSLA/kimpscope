OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/

# 업비트 공지 수신 (서버 전용, 공지 구독에는 별도 scope 불필요)
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
# 영구 디스크 사용 시 해당 경로 아래로 설정
# NOTICE_DB_PATH=/persistent/notices.sqlite3
# CHROMA_PATH=/persistent/chroma

# 키 없이 빗썸 공개 공지 수집 (기본 활성, 최소 60초)
BITHUMB_NOTICES_ENABLED=true
NOTICE_POLL_SECONDS=300
